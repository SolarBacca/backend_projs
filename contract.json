{
  "base_url": "http://localhost:8000",
  "resource": "events",
  "id_field": "id",
  "missing_id": "999999",
  "list_key": null,
  "text_field": "title",
  "search": {
    "param": "q",
    "field": "title"
  },
  "create": {
    "title": "Python Meetup",
    "date": "2026-12-15T19:00:00",
    "location": "Коворкинг Центр",
    "capacity": 2
  },
  "update": {
    "capacity": 100
  },
  "required_field": "title",
  "errors": [
    {"body": {"title": ""}, "field": "title"},
    {"body": {"location": ""}, "field": "location"},
    {"body": {"capacity": -1}, "field": "capacity"}
  ],
  "child": {
    "resource": "registrations",
    "create": {
      "name": "Иван Иванов",
      "email": "ivan@example.com"
    },
    "parent_field": "event_id"
  },
  "rule": {
    "description": "Нельзя зарегистрироваться, если лимит исчерпан",
    "parent": { "capacity": 1 },
    "setup": [
      {
        "method": "POST",
        "path": "/api/events/{id}/registrations",
        "body": { "name": "Иван", "email": "ivan@test.com" }
      }
    ],
    "violate": {
      "method": "POST",
      "path": "/api/events/{id}/registrations",
      "body": { "name": "Пётр", "email": "petr@test.com" }
    },
    "expect_status": 409
  },

  "auth": {
    "scheme": "basic",
    "schemes": ["basic", "bearer"],
    "register_path": "/auth/register",
    "login_path": "/auth/login",
    "me_path": "/auth/me",
    "login_field": "username",
    "password_field": "password",
    "token_field": "access_token",
    "owner_field": "owner_id",

    "admin": {
      "username": "admin",
      "password": "admin-test-pass"
    },
    "test_user": {
      "username": "testuser",
      "password": "testpass123"
    },
    "other_user": {
      "username": "otheruser",
      "password": "otherpass123"
    },
    "invalid_password": "wrong-password",

    "tests": {
      "register_duplicate": {
        "description": "Повтор логина → 409 (пункт 1)",
        "expect_status": 409
      },
      "unauthorized": {
        "description": "Изменение без авторизации → 401 (пункт 3)",
        "method": "PUT",
        "path": "/api/events/{id}",
        "expect_status": 401,
        "detail_is_generic": true
      },
      "invalid_credentials": {
        "description": "Неверный пароль → 401 без подсказки, неверный логин → 401 без подсказки (пункт 3)",
        "expect_status": 401,
        "detail_is_generic": true
      },
      "forbidden": {
        "description": "Чужая запись → 403 (пункт 6)",
        "expect_status": 403
      },
      "me_response": {
        "description": "GET /auth/me не содержит пароля и хэша (пункт 4)",
        "forbidden_fields": ["password", "password_hash", "passwordHash"],
        "required_fields": ["id", "username"]
      },
      "owner_server_set": {
        "description": "owner_id проставляет сервер, клиент не может его задать (пункт 5)",
        "client_must_not_send_field": true
      },
      "rate_limit": {
        "description": "5 неверных попыток входа подряд → 429 (★★)",
        "attempts": 5,
        "expect_status": 429
      },
      "jwt_expired": {
        "description": "Истёкший токен → 401 (★)",
        "expect_status": 401
      },
      "jwt_tampered": {
        "description": "Подделанный токен → 401 (★)",
        "expect_status": 401
      },
      "admin_can_edit_any": {
        "description": "Админ может изменять любое событие (★★)",
        "expect_status": 200
      }
    }
  }
}